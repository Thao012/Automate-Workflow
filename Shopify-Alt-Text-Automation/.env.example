# Shopify Alt Text Automation - Environment Configuration
# Copy this file to .env and fill in your specific values

# ===========================================
# SHOPIFY API CONFIGURATION
# ===========================================

# Your Shopify store's API token
# Get this from: Admin → Apps → App and sales channel settings → Develop apps
SHOPIFY_TOKEN=shpat_your_private_app_token_here

# Your Shopify store name (the part before .myshopify.com)
# Example: if your store is "mystore.myshopify.com", use "mystore"
SHOPIFY_SHOP_NAME=your-shop-name

# Shopify API version (recommended: 2023-10)
SHOPIFY_API_VERSION=2023-10

# ===========================================
# RATE LIMITING CONFIGURATION
# ===========================================

# Delay between API requests (milliseconds)
# Recommended: 1000 (1 second) to avoid rate limiting
API_RATE_LIMIT_DELAY=1000

# Maximum concurrent requests
# Recommended: 1 for safety
MAX_CONCURRENT_REQUESTS=1

# Maximum retry attempts for failed requests
MAX_RETRIES=3

# ===========================================
# BRAND CONFIGURATION
# ===========================================

# Your brand name to append to alt text
# Example: "Product Name - Your Brand"
BRAND_NAME=Your Brand Name

# Alt text format template
# Variables: {productName}, {brandName}, {variant}
ALT_TEXT_FORMAT={productName} - {brandName}