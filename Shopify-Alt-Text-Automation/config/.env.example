# Shopify API Configuration Template
# Copy this file to .env and fill in your actual credentials

# Shopify Store Configuration
SHOPIFY_STORE_URL=your-store-name.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_private_app_access_token

# API Settings
API_VERSION=2023-10
REQUEST_TIMEOUT=30000
RATE_LIMIT_DELAY=500

# Logging
LOG_LEVEL=info
DEBUG_MODE=false

# Batch Processing
BATCH_SIZE=50
MAX_CONCURRENT_REQUESTS=5

# Alt Text Configuration
DEFAULT_ALT_PREFIX="Product image:"
SKIP_EXISTING_ALT=false
BACKUP_BEFORE_UPDATE=true

# Safety Settings
DRY_RUN=true
CONFIRM_UPDATES=true

# Notes:
# - Never commit .env file to version control
# - Keep your access token secure
# - Test with DRY_RUN=true first
# - Set reasonable rate limits to avoid API throttling